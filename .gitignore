# What this repository publishes is the method: the library, the scripts that run it, and
# the archived results every dissertation number traces back to. Everything below is
# deliberately excluded, either because it is not ours to publish, because it is too large
# for git, or because the pipeline regenerates it.

# --- the dataset: collected by the data author, not redistributed here -------------------
2025Sep18.tar.gz
2025Sep18.listing.txt
*.tar.gz
_crops/
_crops_*/

# --- trained weights and the embeddings read back from them ------------------------------
# 48 checkpoints, roughly 51 GB. Available on request; the ladder retrains them in half a
# GPU-day.
*.pt
*.pth
*.npz
*.npy

# --- caches the pipeline rebuilds on demand ----------------------------------------------
# _imgcache.npy is 15 GB and is rebuilt by "vitb_unsup.py --build-cache";
# artifacts/ holds the phase-1 signals (artifacts2/, with the archived results, IS tracked).
_imgcache*
artifacts/
hf_cache/
torch_cache/

# --- run output ---------------------------------------------------------------------------
*.log
*.err
*.out
logs/
slurm-*.out
# snapshots taken by hpc/07_fuse_eval.sbatch before it rewrites the archived results
artifacts2_reference_*/

# --- bulk intermediates inside the tracked results directory ------------------------------
# 61 MB combined, regenerated by repro/build_phase1.py. The small control CSVs next to them
# (topology_gt, tier3_clusters, the noise-injected label sets) stay tracked.
artifacts2/manifest.csv
artifacts2/pairs_tier*.csv

# --- dissertation sources and slide decks: not part of the code release --------------------
paper_latex/
paper_latex_overleaf_*/
paperexample/
old_packages/
figures/
docs/*.pptx
docs/*.html
*.zip
*.pdf

# --- local tooling and environments --------------------------------------------------------
.claude/
.venv/
venv/
settings.local.json
.vscode/
.idea/

# --- python ---------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- os droppings ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
